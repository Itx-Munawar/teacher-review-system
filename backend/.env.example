# =============================================================
# Teacher Review System - Backend Environment Variables
# Copy this file to .env and fill in the values.
# =============================================================

# ---- Required ----
# Must be at least 32 characters. The server refuses to start with a shorter
# one. Generate a value with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-48-random-bytes-of-hex
DB_HOST=your-db-host
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=your-db-name

# ---- Optional ----
# DB_PORT: your provider's MySQL port. 24580 is the Render default; Aiven
# shows its own port in Service Overview -> Host and port.
DB_PORT=24580
DB_CONNECTION_LIMIT=20
# DB_SSL=true is REQUIRED for Aiven (TLS is enforced by the service).
DB_SSL=false
# DB_SSL_CA turns on certificate verification. Paste the provider's CA as inline
# PEM (starting with -----BEGIN CERTIFICATE-----) or give a file path. Without
# it the connection is encrypted but the server is not authenticated.
DB_SSL_CA=
# Cost factor for new/changed passwords (clamped to 10-15, default 12).
# Existing hashes keep verifying regardless - bcrypt stores the cost inside
# each hash, so this only affects passwords set from now on.
BCRYPT_ROUNDS=12
PORT=5000
FRONTEND_URL=http://localhost:3000
# Idle lifetime of an admin session in minutes (5-1440, default 30). Each
# authenticated request slides the expiry forward; the browser cookie and the
# JWT share this limit.
ADMIN_SESSION_MINUTES=30
# ---- Audit log ----
# IPs in audit_logs are stored as a keyed hash, never as readable addresses.
# Keep this stable if you rotate JWT_SECRET, otherwise old and new hashes stop
# correlating. Defaults to JWT_SECRET when unset.
AUDIT_IP_SALT=
# Audit rows older than this many days are deleted on boot and once a day
# (7-3650, default 90).
AUDIT_LOG_RETENTION_DAYS=90

# ---- Email (required for password reset) ----
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# ---- CORS ----
# Comma-separated exact origins that may send the admin cookie. The production
# Vercel URL and the origin of FRONTEND_URL are always allowed; add any other
# first-party origin here. Preview hosts (*.vercel.app, *.monkeycode-ai.live)
# can read public endpoints but are never granted credentialed access.
CORS_ALLOWED_ORIGINS=https://teacher-review-system-zeta.vercel.app

# ---- Admin Setup ----
# The code reads ADMIN_SETUP_KEY; ADMIN_SETUP_SECRET is accepted as an alias so
# an environment that followed the older example file still works. Unset = the
# /api/admin/setup route answers 404.
ADMIN_SETUP_KEY=your-setup-secret
# ADMIN_SETUP_SECRET=your-setup-secret
# This route can only create the FIRST admin account. Changing an existing
# account needs an authenticated admin session, or temporarily flipping this to
# true when you have lost both the password and the session. Set it back to
# false as soon as recovery is done.
ADMIN_SETUP_ALLOW_OVERWRITE=false
